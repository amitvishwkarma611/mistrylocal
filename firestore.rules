rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helpers
    // =========================
    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    function isValidProfession() {
      return request.resource.data.profession in ['carpenter', 'plumber', 'electrician'];
    }

    // =========================
    // Users collection (restore for auth)
    // =========================
    match /users/{userId} {
      // User can read their own profile
      allow read: if isOwner(userId);
      
      // Create allowed only for the user themselves
      allow create: if isOwner(userId);
      
      // Update allowed only for the user themselves
      allow update: if isOwner(userId);
      
      // Prevent deletion of user profiles
      allow delete: if false;
    }

    // =========================
    // Carpenters collection (existing)
    // =========================
    match /carpenters/{carpenterId} {
      allow read: if isLoggedIn();
      // Allow updates that preserve ownership and prevent unauthorized field changes
      allow create, update: if isOwner(carpenterId);
      allow delete: if false;  // Prevent accidental deletion
    }

    // =========================
    // Plumbers collection (missing)
    // =========================
    match /plumbers/{plumberId} {
      allow read: if isLoggedIn();
      // Allow updates that preserve ownership and prevent unauthorized field changes
      allow create, update: if isOwner(plumberId);
      allow delete: if false;  // Prevent accidental deletion
    }

    // =========================
    // Electricians collection (missing)
    // =========================
    match /electricians/{electricianId} {
      allow read: if isLoggedIn();
      // Allow updates that preserve ownership and prevent unauthorized field changes
      allow create, update: if isOwner(electricianId);
      allow delete: if false;  // Prevent accidental deletion
    }

    // =========================
    // Customers collection (missing)
    // =========================
    match /customers/{customerId} {
      allow read: if isLoggedIn();
      // Allow updates that preserve ownership and prevent unauthorized field changes
      allow create, update: if isOwner(customerId);
      allow delete: if false;  // Prevent accidental deletion
    }

    // =========================
    // Workers collection (generic for all professions)
    // =========================
    match /workers/{workerId} {
      // Worker apna profile read/write kar sakta hai
      allow read: if isOwner(workerId);
      
      // Create only once with valid profession
      allow create: if isOwner(workerId) && isValidProfession();
      
      // Update rules that allow changes but maintain ownership
      allow update: if isOwner(workerId);

      // No wallet balance field in this collection - using dedicated wallet collections instead
    }

    // =========================
    // Wallet collections for different professions
    // =========================
    match /carpenter_wallets/{workerId} {
      allow read: if isOwner(workerId);
      // Allow creation of wallet with proper initial data only
      allow create: if isOwner(workerId) 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.balance == 200  // Welcome credit amount
        && request.resource.data.totalRecharge == 0
        && request.resource.data.totalSpent == 0
        && request.resource.data.welcomeCreditGiven == true;
      // Allow updates that maintain data integrity but prevent arbitrary balance changes
      // Balance changes should only happen through backend transactions with proper validation
      allow update: if isOwner(workerId)
        // For partial updates, only check fields that exist in both old and new data
        && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)  // Can't change userId if being updated
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);  // Can't change creation time if being updated
    }
    
    match /plumber_wallets/{workerId} {
      allow read: if isOwner(workerId);
      // Allow creation of wallet with proper initial data only
      allow create: if isOwner(workerId) 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.balance == 200  // Welcome credit amount
        && request.resource.data.totalRecharge == 0
        && request.resource.data.totalSpent == 0
        && request.resource.data.welcomeCreditGiven == true;
      // Allow updates that maintain data integrity but prevent arbitrary balance changes
      // Balance changes should only happen through backend transactions with proper validation
      allow update: if isOwner(workerId)
        // For partial updates, only check fields that exist in both old and new data
        && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)  // Can't change userId if being updated
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);  // Can't change creation time if being updated
    }
    
    match /electrician_wallets/{workerId} {
      allow read: if isOwner(workerId);
      // Allow creation of wallet with proper initial data only
      allow create: if isOwner(workerId) 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.balance == 200  // Welcome credit amount
        && request.resource.data.totalRecharge == 0
        && request.resource.data.totalSpent == 0
        && request.resource.data.welcomeCreditGiven == true;
      // Allow updates that maintain data integrity but prevent arbitrary balance changes
      // Balance changes should only happen through backend transactions with proper validation
      allow update: if isOwner(workerId)
        // For partial updates, only check fields that exist in both old and new data
        && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)  // Can't change userId if being updated
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);  // Can't change creation time if being updated
    }

    // =========================
    // Bookings collection
    // =========================
    match /bookings/{bookingId} {
      // Allow authenticated users to read bookings
      allow read: if isLoggedIn();
      
      // More granular write permissions based on user role
      allow create: if isLoggedIn()
        && (request.auth.uid == request.resource.data.customerId 
             || request.auth.uid == request.resource.data.workerId);
      
      // Update rules: allow if user is customer or worker for this booking
      allow update: if isLoggedIn()
        && (request.auth.uid == resource.data.customerId 
             || request.auth.uid == resource.data.workerId);
      
      // Prevent direct deletion of bookings
      allow delete: if false;
    }

    // =========================
    // Wallet Transactions
    // =========================
    match /wallet_transactions/{txnId} {
      // Worker sirf apne transactions dekh sakta hai
      allow read: if isLoggedIn()
        && resource.data.workerId == request.auth.uid;

      // Frontend se transaction create/update/delete block
      allow write: if false;
    }

    // =========================
    // Payment Orders (for Razorpay integration)
    // =========================
    match /payment_orders/{orderId} {
      // Users can read their own payment orders
      allow read: if isLoggedIn() 
        && resource.data.userId == request.auth.uid;
      
      // Only backend can create/update payment orders
      allow create, update: if false;
    }

  }
}